# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Manila
NEXT_PUBLIC_APPOINTMENT_LEAD_MINUTES=30

# Clinic branding (used in reminder emails)
CLINIC_NAME=Your Clinic Name
CLINIC_ADDRESS=123 Main St, City

# Vercel Cron (required in production; min 16 characters)
CRON_SECRET=generate-a-random-secret-at-least-16-chars

# Email reminders via Resend (optional locally; pair both or omit both)
# https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=reminders@yourdomain.com

# Retention purge cron — days to keep rate_limits and audit_log (default 90)
RETENTION_DAYS=90

# Error tracking (optional — structured logs used when unset)
NEXT_PUBLIC_SENTRY_DSN=
